# Public Supabase project settings. These values are intentionally exposed to
# the browser; authorization is enforced by PostgreSQL Row Level Security.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Public feature flags. Set to true only after the matching provider is enabled
# and its client ID/secret and redirect URLs are configured in Supabase.
VITE_SUPABASE_OAUTH_GOOGLE_ENABLED=
VITE_SUPABASE_OAUTH_X_ENABLED=

# Server-only. Never prefix this variable with VITE_ and never expose it to the
# browser. Use only in trusted server code after authorization checks.
SUPABASE_SERVICE_ROLE_KEY=

# Server/deployment migration connection. Prefer Supabase's direct connection
# for migrations; use the pooler for serverless application traffic later.
SUPABASE_DATABASE_URL=

# Optional server-only scientific API settings. NCBI works at low volume without a key.
NCBI_API_KEY=
# Optional real technical contact used for the Crossref polite pool; never invent a value.
CROSSREF_MAILTO=

# Dedicated, server-only authorization and query for the manually triggered scientific pilot.
# Do not reuse SUPABASE_SERVICE_ROLE_KEY as the endpoint token.
SCIENTIFIC_INGESTION_TOKEN=
SCIENTIFIC_PILOT_QUERY=

# Server-only scientific summary generation. Disabled by default (fail closed).
AI_SUMMARY_ENABLED=
AI_SUMMARY_PROVIDER=
AI_SUMMARY_MODEL=
AI_SUMMARY_MAX_INPUT_CHARS=
AI_SUMMARY_MAX_OUTPUT_TOKENS=
AI_SUMMARY_MAX_ATTEMPTS=
AI_SUMMARY_TIMEOUT_MS=
# Required only when AI_SUMMARY_ENABLED=true and AI_SUMMARY_PROVIDER=openai.
OPENAI_API_KEY=
